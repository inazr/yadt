<idea-plugin>
    <id>com.inazr.yadt</id>
    <name>YADT — Yet Another dbt Tool</name>
    <vendor email="yadt@stephan-ohm.com" url="https://github.com/inazr/yadt">inazr</vendor>
    <description><![CDATA[
<p><b>YADT</b> (Yet Another dbt Tool) adds lineage visualization, code intelligence, and a
command runner for <a href="https://www.getdbt.com/">dbt</a> projects to JetBrains IDEs —
IntelliJ IDEA, PyCharm, DataSpell, and other IntelliJ-Platform IDEs. It reads your project's
compiled <code>manifest.json</code>, so it works with dbt Core and detects and supports the
dbt Fusion engine and the dbt Cloud CLI.</p>

<h3>Lineage graph</h3>
<ul>
  <li>Interactive DAG of models, sources, seeds, snapshots, exposures, and tests</li>
  <li>Drive the graph by typing a dbt selector — <code>tag:</code>, <code>path:</code>, <code>source:</code>, fqn, globs, and graph operators like <code>2+my_model+</code> — with autocomplete as you type</li>
  <li>Click a node to open its file; expand boundary nodes to explore deeper dependencies</li>
  <li>Build status and source freshness shown on the cards; failing tests flagged separately</li>
  <li>Configurable depth, layout direction, and edge style; adapts to your full IDE theme</li>
  <li>Copy the visible graph to the clipboard as an image for documentation</li>
  <li>Auto-updates when the manifest changes</li>
</ul>

<h3>Code intelligence</h3>
<ul>
  <li><b>Autocompletion</b> — <code>ref()</code>, <code>source()</code>, <code>macro()</code> suggestions with descriptions</li>
  <li><b>Go to definition</b> — Ctrl/Cmd+Click a <code>ref()</code> / <code>source()</code> to jump to the file</li>
  <li><b>Documentation on hover</b> — columns, materialization, tags, descriptions</li>
  <li><b>Annotations</b> — unresolved <code>ref()</code> / <code>source()</code> highlighted as warnings</li>
  <li>Works in .sql, .jinja, and .jinja2 files</li>
</ul>

<h3>Runner</h3>
<ul>
  <li><b>Run / Build / Test / Compile</b> a single model or any dbt selection</li>
  <li><b>Preview</b> rows with <code>dbt show</code>; <b>full-refresh</b> toggle for incremental models</li>
  <li><b>Docs generate</b> to rebuild documentation</li>
  <li>Flags discovered from your installed dbt, target selector, stop button, streaming output log</li>
  <li>Native OS notifications when commands finish</li>
</ul>

<h3>Copy &amp; paste</h3>
<ul>
  <li><b>Copy for Target DB</b> (Cmd+Shift+C) — <code>ref()</code>/<code>source()</code> replaced by database.schema.table</li>
  <li><b>Paste as dbt Refs</b> (Cmd+Shift+V) — table names replaced by <code>ref()</code>/<code>source()</code> calls</li>
</ul>

<h3>Docs viewer</h3>
<p>Browse model documentation in a built-in panel — columns, descriptions, tags, and dependencies.</p>

<p><em>Not affiliated with or endorsed by dbt Labs. dbt is a trademark of dbt Labs, Inc.</em></p>
    ]]></description>

    <!-- change-notes ("What's New") is generated from CHANGELOG.md by the
         org.jetbrains.changelog Gradle plugin and injected via patchPluginXml. -->

    <depends>com.intellij.modules.platform</depends>
    <!-- LineageTab embeds a JCEF browser (com.intellij.ui.jcef.*). Up to build 261 those
         classes were part of the platform core, but 262 (2026.2) moved them into a separate bundled
         plugin "Web Browser (JCEF)" (id com.intellij.modules.jcef) whose classes are NOT reachable
         from our classloader unless we declare this dependency — without it the tool window dies with
         NoClassDefFoundError: com/intellij/ui/jcef/JBCefJSQuery$Response.
         It must stay *optional*: the id does not exist before 262, and a required <depends> on a
         missing plugin makes the IDE refuse to load YADT at all (sinceBuild is 251).
         A resolved optional <depends> still contributes the target plugin's content modules to our
         classloader parents, which is exactly what makes com.intellij.ui.jcef resolvable on 262+. -->
    <depends optional="true" config-file="yadt-jcef.xml">com.intellij.modules.jcef</depends>

    <resource-bundle>messages.DbtHelperBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Project Services -->
        <projectService serviceImplementation="com.dbthelper.settings.DbtHelperSettings"/>
        <projectService serviceImplementation="com.dbthelper.core.ManifestService"/>
        <projectService serviceImplementation="com.dbthelper.core.CatalogParser"/>
        <projectService serviceImplementation="com.dbthelper.core.ProfilesParser"/>
        <projectService serviceImplementation="com.dbthelper.core.DbtRunState"/>
        <projectService serviceImplementation="com.dbthelper.listeners.RunResultsWatcher"/>
        <postStartupActivity implementation="com.dbthelper.listeners.RunResultsWatcherStarter"/>
        <postStartupActivity implementation="com.dbthelper.charts.DbtChartsSchemaStarter"/>

        <!-- Tool Window -->
        <toolWindow id="YADT"
                    anchor="bottom"
                    sideToolWindow="true"
                    icon="/icons/dbt.svg"
                    factoryClass="com.dbthelper.toolwindow.DbtToolWindowFactory"/>

        <!-- Settings -->
        <projectConfigurable
                parentId="tools"
                instance="com.dbthelper.settings.DbtHelperConfigurable"
                id="com.dbthelper.settings.DbtHelperConfigurable"
                displayName="YADT"/>

        <!-- Code Intelligence (TEXT = IntelliJ IDEA, Jinja2/SQL = DataSpell/PyCharm) -->
        <completion.contributor language="any"
                               implementationClass="com.dbthelper.codeintel.DbtCompletionContributor"/>

        <psi.referenceContributor language="TEXT"
                                  implementation="com.dbthelper.codeintel.DbtReferenceContributor"/>
        <psi.referenceContributor language="Jinja2"
                                  implementation="com.dbthelper.codeintel.DbtReferenceContributor"/>
        <psi.referenceContributor language="SQL"
                                  implementation="com.dbthelper.codeintel.DbtReferenceContributor"/>

        <lang.documentationProvider language="TEXT"
                                    implementationClass="com.dbthelper.codeintel.DbtDocumentationProvider"/>
        <lang.documentationProvider language="Jinja2"
                                    implementationClass="com.dbthelper.codeintel.DbtDocumentationProvider"/>
        <lang.documentationProvider language="SQL"
                                    implementationClass="com.dbthelper.codeintel.DbtDocumentationProvider"/>

        <!-- V2 documentation API — drives the no-modifier hover popup in IDEA 2023+.
             targetProvider (offset-based) runs BEFORE PSI dispatch and is required for
             DataSpell/PyCharm where the bundled SQL plugin would otherwise hijack hover. -->
        <platform.backend.documentation.targetProvider
                implementation="com.dbthelper.codeintel.DbtDocumentationTargetProvider"/>
        <platform.backend.documentation.psiTargetProvider
                implementation="com.dbthelper.codeintel.DbtPsiDocumentationTargetProvider"/>

        <annotator language="TEXT"
                   implementationClass="com.dbthelper.codeintel.DbtAnnotator"/>
        <annotator language="Jinja2"
                   implementationClass="com.dbthelper.codeintel.DbtAnnotator"/>
        <annotator language="SQL"
                   implementationClass="com.dbthelper.codeintel.DbtAnnotator"/>

        <annotator language="TEXT"
                   implementationClass="com.dbthelper.codeintel.TerminalColumnAnnotator"/>
        <annotator language="Jinja2"
                   implementationClass="com.dbthelper.codeintel.TerminalColumnAnnotator"/>
        <annotator language="SQL"
                   implementationClass="com.dbthelper.codeintel.TerminalColumnAnnotator"/>

        <gotoDeclarationHandler implementation="com.dbthelper.codeintel.DbtGotoDeclarationHandler"/>

        <!-- Notifications -->
        <notificationGroup id="YADT" displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="dbtHelper.YadtMenu" text="YADT" popup="true">
            <action id="dbtHelper.CopyForTarget"
                    class="com.dbthelper.actions.CopyWithRefsReplacedAction"
                    text="Copy for Target DB"
                    description="Copy SQL with ref/source replaced by database.schema.table">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift C"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift C"/>
            </action>
            <action id="dbtHelper.PasteAsRefs"
                    class="com.dbthelper.actions.PasteAsRefsAction"
                    text="Paste as dbt Refs"
                    description="Paste SQL with table names replaced by ref/source calls">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift V"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift V"/>
            </action>
            <action id="dbtHelper.ConvertRefRelation"
                    class="com.dbthelper.actions.ToggleRefRelationAction"
                    text="Convert: ref ↔ Relation"
                    description="Convert the selection in place between ref()/source() and database.schema.table"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="$Paste"/>
            <add-to-group group-id="EditMenu" anchor="after" relative-to-action="$Paste"/>
        </group>
        <!-- No default keyboard-shortcut: bind these under Settings > Keymap. -->
        <action id="dbtHelper.RunCommand"
                class="com.dbthelper.actions.RunDbtCommandAction"
                text="dbt: Run / Stop"
                description="Run the configured dbt command, or stop the running one — same as the YADT Runner RUN button">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="dbtHelper.ClearOutput"
                class="com.dbthelper.actions.ClearDbtOutputAction"
                text="dbt: Clear Output"
                description="Clear the YADT Runner output log — same as the Clear button">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <projectListeners>
        <listener class="com.dbthelper.listeners.DbtFileListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
        <listener class="com.dbthelper.listeners.ManifestFileWatcher"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="com.dbthelper.listeners.AutoParseOnSaveListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>
</idea-plugin>
